{
  "name": "squad-chat-bridge",
  "private": true,
  "type": "module",
  "description": "Node child process that holds the Supabase connection for the squad-chat mod.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/bridge.mjs --bundle --platform=node --target=node22 --format=esm --legal-comments=none --outfile=dist/bridge.mjs",
    "test": "node --test ../../../bridge-tests/*.test.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.117.2",
    "esbuild": "0.28.2"
  }
}
