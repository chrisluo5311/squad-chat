{
  "schema": 1,
  "id": "lofi",
  "version": "1.2.0",
  "name": "Lo-fi",
  "icon": "♫",
  "color": "coral",
  "description": "Lo-fi streams, YouTube and your own music, played in the background through mpv, as Pixel Play does.",
  "author": "squad-chat",
  "permissions": { "hosts": ["ice2.somafm.com", "www.youtube.com"] },
  "settings": {
    "volume": { "type": "int", "label": "Starting volume", "default": 60, "min": 0, "max": 100 }
  },
  "providers": [
    {
      "id": "p",
      "type": "player",
      "params": {
        "volume": "$settings.volume",
        "stations": [
          { "name": "Lofi Girl", "url": "https://www.youtube.com/@LofiGirl/streams" },
          { "name": "Groove Salad", "url": "https://ice2.somafm.com/groovesalad-128-mp3" },
          { "name": "Fluid", "url": "https://ice2.somafm.com/fluid-128-mp3" },
          { "name": "Lush", "url": "https://ice2.somafm.com/lush-128-mp3" },
          { "name": "Drone Zone", "url": "https://ice2.somafm.com/dronezone-128-mp3" }
        ]
      },
      "interval": { "visible": "1s", "background": "10s" }
    }
  ],
  "layout": {
    "cards": [
      {
        "title": "NOW PLAYING",
        "meta": "{p.now.state}",
        "body": [
          { "type": "text", "text": "{p.now.mark} {p.now.title}\n{p.now.source}\n{p.now.timeText}" },
          { "type": "meter", "label": "Volume", "value": "p.now.volume", "color": "coral" },
          { "type": "buttons", "buttons": [
            { "label": "⏮", "action": "prev" },
            { "label": "▶", "alt": "⏸", "altWhen": "p.playing", "action": "pause" },
            { "label": "⏹", "action": "stop" },
            { "label": "⏭", "action": "next" },
            { "label": "−", "action": "down" },
            { "label": "+", "action": "up" }
          ] },
          { "type": "text", "text": "{p.hint}\n{p.conflict}", "color": "amber" }
        ],
        "desktop": [
          { "type": "media", "title": "{p.now.title}", "sub": "{p.now.source}", "progress": "p.now.pct", "elapsed": "{p.now.posText}", "total": "{p.now.durText}", "live": "p.now.live", "playing": "p.playing", "empty": "Not playing. Press ▶ on a station below." },
          { "type": "buttons", "split": 4, "level": "p.now.volume", "buttons": [
            { "label": "⏮", "action": "prev" },
            { "label": "▶", "alt": "⏸", "altWhen": "p.playing", "action": "pause" },
            { "label": "⏹", "action": "stop" },
            { "label": "⏭", "action": "next" },
            { "label": "−", "action": "down" },
            { "label": "+", "action": "up" }
          ] },
          { "type": "text", "text": "{p.hint}\n{p.conflict}", "color": "amber" }
        ]
      },
      {
        "title": "STATIONS & TRACKS",
        "meta": "{p.count}",
        "body": { "type": "list", "items": "p.entries", "title": "name", "mark": "on", "tag": "tag", "act": { "label": "▶", "action": "play", "field": "id" }, "empty": "Nothing yet: paste a URL or path below, then add" },
        "desktop": { "type": "list", "items": "p.entries", "title": "name", "lit": "on", "tag": "tag", "act": { "label": "▶", "action": "play", "field": "id" }, "pause": "pause", "remove": { "label": "✕", "action": "remove", "field": "id" }, "empty": "Nothing yet: paste a URL or path below, then add" }
      }
    ],
    "inline": [
      { "type": "text", "text": "{p.band}" },
      { "type": "select", "items": "p.entries", "title": "name", "lit": "on", "act": { "label": "♫", "action": "play", "field": "id" }, "empty": "Pick a station or track" },
      { "type": "buttons", "split": 3, "level": "p.now.volume", "buttons": [
        { "label": "⏮", "action": "prev" },
        { "label": "▶", "alt": "⏸", "altWhen": "p.playing", "action": "pause" },
        { "label": "⏭", "action": "next" },
        { "label": "−", "action": "down" },
        { "label": "+", "action": "up" }
      ] }
    ],
    "pills": [
      {"draw": {"type": "equalizer", "flag": "p.playing"}, "color": "coral", "msg": "{p.now.title}", "tip": ["{p.now.title}", "{p.now.source}"]},
      {"when": "p.now.pct", "draw": {"type": "progress", "value": "p.now.pct"}, "color": "coral", "sub": "{p.now.timeText}"},
      {"color": "sand", "label": "vol", "value": "{p.now.volume}"}
    ],
    "band": "{p.band}",
    "snapshot": "{p.share}",
    "keys": { "p": "pause", "n": "next", "b": "prev", "s": "stop", "u": "up", "d": "down" },
    "add": { "action": "add", "field": "target" },
    "hint": "p plays/pauses · n next · b back · u/d volume · a URL or path, then add",
    "placeholder": "Paste a URL or path, then add · p · n · b · u · d · /help"
  }
}
