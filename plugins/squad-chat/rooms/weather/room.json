{
  "schema": 1,
  "id": "weather",
  "version": "1.2.1",
  "name": "Weather",
  "icon": "☀",
  "color": "sky",
  "description": "Now, the next 24 hours and the week, for the cities you pick. From Open-Meteo, no key needed.",
  "author": "squad-chat",
  "permissions": { "hosts": ["api.open-meteo.com", "geocoding-api.open-meteo.com", "air-quality-api.open-meteo.com"] },
  "settings": {
    "cities": { "type": "list", "label": "Cities", "default": ["Taipei"], "add": true, "min": 1, "max": 6 },
    "units": { "type": "enum", "label": "Units", "values": ["metric", "imperial"], "default": "metric" },
    "city": { "type": "string", "label": "Showing", "default": "Taipei" }
  },
  "providers": [
    { "id": "wx", "type": "open-meteo", "params": { "cities": "$settings.cities", "units": "$settings.units" }, "interval": { "visible": "10m", "background": "30m" } }
  ],
  "layout": {
    "cards": [
      {
        "title": "NOW",
        "meta": "updated {wx.updated}",
        "body": {
          "type": "table",
          "items": "wx.cities",
          "columns": [
            { "field": "icon", "width": 2, "color": "amber" },
            { "field": "place", "grow": true },
            { "field": "tempText", "width": 5, "right": true },
            { "field": "aqiText", "width": 7, "right": true }
          ],
          "drop": { "setting": "cities", "field": "query" },
          "pick": { "setting": "city", "field": "query", "as": "wx.first" },
          "empty": "No cities yet: /set cities Taipei, Tokyo"
        },
        "desktop": { "type": "grid", "items": "wx.cities", "title": "name", "icon": "icon", "value": "tempText", "sub": "desc", "note": "rangeRain", "across": 3, "pickTitle": true, "hint": "Press a city's name to show its next 24 hours, week and sun below.", "pick": { "setting": "city", "field": "query", "as": "wx.first" }, "drop": { "setting": "cities", "field": "query" }, "empty": "No cities yet: type one below, then add" }
      },
      {
        "title": "NEXT 24 HOURS",
        "meta": "{wx.first.name}",
        "body": { "type": "text", "text": "{wx.first.icon} {wx.first.desc}, {wx.first.feels} · humidity {wx.first.humidity} · wind {wx.first.wind}\n{wx.first.rainLine}" },
        "desktop": [
          { "type": "text", "text": "{wx.first.desc}, {wx.first.feels} · humidity {wx.first.humidity} · wind {wx.first.wind}" },
          { "type": "forecast", "values": "wx.first.tempHours", "bars": "wx.first.rainHours", "marks": "wx.first.hourMarks", "caption": "{wx.first.hourLine}", "color": "amber", "color2": "sky" }
        ]
      },
      {
        "title": "THIS WEEK",
        "meta": "{wx.first.name}",
        "body": {
          "type": "table",
          "items": "wx.first.days",
          "columns": [
            { "field": "day", "width": 6 },
            { "field": "icon", "width": 2, "color": "amber" },
            { "field": "range", "width": 12, "right": true },
            { "field": "rain", "right": true, "color": "sky" }
          ]
        },
        "desktop": { "type": "strip", "items": "wx.first.days", "title": "day", "icon": "icon", "value": "hiText", "sub": "loText", "note": "rainPct", "lit": "today" }
      },
      {
        "title": "SUNRISE & SUNSET",
        "meta": "{wx.first.name}",
        "badge": "{wx.first.sun.uvText}",
        "badgeTone": "wx.first.sun.uvTone",
        "when": "wx.first.sun",
        "body": { "type": "text", "text": "{wx.first.sunLine}" },
        "desktop": { "type": "sun", "rise": "{wx.first.sun.rise}", "set": "{wx.first.sun.set}", "value": "wx.first.sun.pct", "sub": "{wx.first.sun.length}", "note": "{wx.first.sun.next}" }
      }
    ],
    "inline": {
      "type": "table",
      "items": "wx.cities",
      "columns": [
        { "field": "icon", "width": 2, "color": "amber" },
        { "field": "name", "width": 13 },
        { "field": "tempText", "width": 5, "right": true },
        { "field": "rainText", "width": 6, "right": true, "color": "sky" },
        { "field": "desc" }
      ],
      "max": 4,
      "empty": "No cities yet: /set cities Taipei"
    },
    "pills": [
      {"when": "wx.first", "draw": {"type": "weather", "value": "wx.first.icon"}, "color": "amber", "label": "{wx.first.name}", "sub": "{wx.first.country}", "value": "{wx.first.tempText}", "tip": ["{wx.first.place} · {wx.first.desc}", "{wx.first.feels} · {wx.first.range}", "humidity {wx.first.humidity} · wind {wx.first.wind}"]},
      {"when": "wx.first", "draw": {"type": "drop", "value": "wx.first.rain"}, "color": "sky", "value": "{wx.first.rain}%", "tip": ["{wx.first.rain}% chance of rain today", "{wx.first.rainLine}"]},
      {"when": "wx.first.rainNext", "draw": {"type": "bars", "value": "wx.first.rainNext"}, "color": "sky", "tip": ["Chance of rain, the next 8 hours"]},
      {"when": "wx.first.aqi", "draw": {"type": "dot"}, "colorFrom": "wx.first.aqiTone", "label": "AQI", "value": "{wx.first.aqi}", "tip": ["Air quality (US AQI) {wx.first.aqi}"]}
    ],
    "band": "{wx.first.icon} {wx.first.name} {wx.first.tempText} · {wx.first.rainText}",
    "snapshot": "{wx.first.share}",
    "add": "cities",
    "hint": "type a city, then add · ✕ drops one · /set units imperial · r refreshes",
    "placeholder": "Type a city (Osaka, New York), then add · /set units imperial · /help"
  }
}
