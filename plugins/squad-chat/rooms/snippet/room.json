{
  "schema": 1,
  "id": "snippet",
  "version": "1.2.0",
  "name": "Snippets",
  "icon": "⌘",
  "color": "amber",
  "description": "Code you reuse, kept on this computer, one click from your clipboard.",
  "author": "squad-chat",
  "permissions": { "hosts": [] },
  "providers": [
    { "id": "list", "type": "local-list", "params": { "max": 200 }, "interval": { "visible": "5s" } }
  ],
  "layout": {
    "cards": [
      {
        "title": "SNIPPETS",
        "meta": "{list.count} saved",
        "body": {
          "type": "list",
          "items": "list.items",
          "title": "name",
          "tag": "lang",
          "preview": "body",
          "copy": "body",
          "share": "body",
          "empty": "Nothing saved yet. /snippet add <text>, or select some code (or let Claude write some), then /snippet add."
        },
        "desktop": {
          "type": "list",
          "items": "list.items",
          "title": "name",
          "tag": "lang",
          "preview": "body",
          "copy": "body",
          "share": "body",
          "act": { "label": "Delete", "action": "delete", "field": "name" },
          "code": true,
          "empty": "Nothing saved yet. /snippet add <text>, or select some code (or let Claude write some), then /snippet add."
        }
      }
    ],
    "inline": { "type": "list", "items": "list.items", "title": "name", "tag": "lang", "copy": "body", "share": "body", "max": 4, "empty": "Nothing saved yet: /snippet add <text>" },
    "pills": [
      {"draw": {"type": "icon", "icon": "stack"}, "color": "amber", "value": "{list.count}", "sub": "saved"},
      {"when": "list.latest", "color": "amber", "value": "{list.latest.name}", "tag": "{list.latest.lang}", "tip": ["Latest saved: {list.latest.name}"]}
    ],
    "band": "{list.count} snippets",
    "hint": "⧉ copies · ⇪ shares · /snippet add|rename|delete",
    "placeholder": "Type or paste text, then add · /snippet delete #2 · /help"
  }
}
