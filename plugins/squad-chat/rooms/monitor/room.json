{
  "schema": 1,
  "id": "monitor",
  "version": "1.2.1",
  "name": "Monitor",
  "icon": "▦",
  "color": "teal",
  "description": "This computer's CPU, memory, GPU, network, disk and battery, and temperatures and power with macmon. Nothing leaves it.",
  "author": "squad-chat",
  "permissions": { "hosts": [] },
  "settings": {
    "alerts": { "type": "bool", "label": "Alerts", "default": true },
    "cpu_temp": { "type": "int", "label": "CPU alert at °C", "default": 95, "min": 50, "max": 110 },
    "memory": { "type": "int", "label": "Memory alert at %", "default": 95, "min": 50, "max": 100 }
  },
  "providers": [
    { "id": "sys", "type": "sysinfo", "params": { "alerts": "$settings.alerts", "cpu_temp": "$settings.cpu_temp", "memory": "$settings.memory" }, "interval": { "visible": "2s", "background": "30s" } }
  ],
  "layout": {
    "cards": [
      {
        "title": "CPU",
        "meta": "{sys.cpu.meta}",
        "body": [
          { "type": "meter", "label": "CPU", "value": "sys.cpu.pct", "right": "{sys.cpu.load}" },
          { "type": "text", "text": "{sys.cpu.spark}", "color": "teal" }
        ],
        "desktop": [
          { "type": "stat", "value": "sys.cpu.pct", "right": "{sys.cpu.load}" },
          { "type": "chart", "values": "sys.cpu.hist", "max": 100, "color": "teal", "caption": "last 2 min" }
        ]
      },
      {
        "title": "MEMORY",
        "when": "sys.mem",
        "meta": "{sys.mem.freeText}",
        "body": [
          { "type": "meter", "label": "Memory", "value": "sys.mem.pct", "right": "{sys.mem.usedText}" },
          { "type": "meter", "label": "Pressure", "value": "sys.mem.pressure" },
          { "type": "meter", "label": "Swap", "value": "sys.mem.swapPct", "right": "{sys.mem.swapText}" }
        ],
        "desktop": [
          { "type": "stat", "value": "sys.mem.pct", "right": "{sys.mem.usedOf}" },
          { "type": "bar", "value": "sys.mem.pct" },
          { "type": "tiles", "tiles": [{ "value": "{sys.mem.pressure}%", "sub": "pressure", "tone": "sys.mem.pressureTone" }, { "value": "{sys.mem.swapPct}%", "sub": "swap · {sys.mem.swapText}", "tone": "sys.mem.swapTone" }] }
        ]
      },
      {
        "title": "GPU & POWER",
        "when": "sys.gpu",
        "meta": "{sys.gpu.tempText}",
        "body": [
          { "type": "meter", "label": "GPU", "value": "sys.gpu.pct", "right": "{sys.gpu.power}" },
          { "type": "text", "text": "{sys.power}\n{sys.fans}\n{sys.sensorHint}" }
        ],
        "desktop": [
          { "type": "tiles", "tiles": [{ "value": "{sys.gpu.pct}%", "sub": "GPU", "tone": "sys.gpu.tone" }, { "value": "{sys.powerParts.cpu}", "sub": "CPU" }, { "value": "{sys.powerParts.gpu}", "sub": "GPU" }, { "value": "{sys.powerParts.all}", "sub": "all" }] },
          { "type": "text", "text": "{sys.fansText}\n{sys.sensorHint}" }
        ]
      },
      {
        "title": "NETWORK",
        "body": [
          { "type": "tiles", "tiles": [{ "value": "↓ {sys.net.rxText}", "sub": "in", "color": "teal" }, { "value": "↑ {sys.net.txText}", "sub": "out", "color": "sky" }] },
          { "type": "text", "text": "↓ {sys.net.rxSpark}\n↑ {sys.net.txSpark}" }
        ],
        "desktop": [
          { "type": "tiles", "tiles": [{ "value": "↓ {sys.net.rxText}", "color": "teal" }, { "value": "↑ {sys.net.txText}", "color": "sky" }] },
          { "type": "chart", "values": "sys.net.rxHist", "values2": "sys.net.txHist", "color": "teal", "color2": "sky", "caption": "last 2 min · ↓ in · ↑ out" }
        ]
      },
      {
        "title": "DISK",
        "when": "sys.disk",
        "meta": "{sys.disk.freeText}",
        "body": { "type": "meter", "label": "Disk", "value": "sys.disk.pct", "right": "{sys.disk.usedText}" }
      },
      {
        "title": "BATTERY",
        "when": "sys.battery",
        "meta": "{sys.battery.detail}",
        "body": { "type": "meter", "label": "Battery", "value": "sys.battery.pct", "right": "{sys.battery.state}" }
      }
    ],
    "inline": [
      { "type": "meter", "label": "CPU", "value": "sys.cpu.pct", "right": "{sys.cpu.tempText}" },
      { "type": "meter", "label": "Memory", "value": "sys.mem.pct", "right": "{sys.mem.usedText}" },
      { "type": "text", "text": "↓ {sys.net.rxText}  ↑ {sys.net.txText}" }
    ],
    "pills": [
      {"draw": {"type": "icon", "icon": "chip"}, "colorFrom": "sys.cpu.tone", "value": "{sys.cpu.pct}%", "tip": ["CPU {sys.cpu.pct}%", "{sys.cpu.meta}", "{sys.cpu.load}"]},
      {"draw": {"type": "area", "value": "sys.cpu.hist"}, "colorFrom": "sys.cpu.tone"},
      {"when": "sys.mem", "draw": {"type": "orbit", "value": "sys.mem.pct"}, "colorFrom": "sys.mem.tone", "label": "mem", "value": "{sys.mem.pct}%", "tip": ["Memory {sys.mem.pct}% used", "{sys.mem.usedText}", "swap {sys.mem.swapText}"]},
      {"draw": {"type": "icon", "icon": "net"}, "color": "sky", "value": "↓{sys.net.rxText}", "sub": "↑{sys.net.txText}", "tip": ["Network", "down {sys.net.rxText} · up {sys.net.txText}"]},
      {"when": "sys.cpu.temp", "draw": {"type": "thermometer", "value": "sys.cpu.temp"}, "colorFrom": "sys.cpu.tempTone", "value": "{sys.cpu.tempText}", "tip": ["CPU {sys.cpu.tempText}", "{sys.fans}"]},
      {"when": "sys.battery", "draw": {"type": "battery", "value": "sys.battery.pct", "flag": "sys.battery.charging"}, "colorFrom": "sys.battery.tone", "value": "{sys.battery.pct}%", "tip": ["Battery {sys.battery.pct}%", "{sys.battery.detail}"]}
    ],
    "band": "{sys.band}",
    "snapshot": "{sys.share}",
    "hint": "/set cpu_temp 90 · /set alerts off · /chat set monitor",
    "placeholder": "/set memory 90 · /set alerts on · /help"
  }
}
